# =============================================================================
# Cheela Dashboard — production
# =============================================================================
# Copy to .env.production.local (or paste into your platform's variable editor)
# and fill in. For local development use .env.example instead.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not
# read at runtime. Changing one means rebuilding, and it is visible to anyone
# who views source — never put a secret behind that prefix.
# =============================================================================


# -----------------------------------------------------------------------------
# Auth — SuperTokens
# -----------------------------------------------------------------------------
# The dashboard hosts the real auth API (sign up/in, refresh, OAuth callback).
# The server only verifies the tokens it issues, so both apps must agree on
# API_DOMAIN and WEBSITE_DOMAIN exactly — a mismatch produces sessions that
# look valid here and fail every API call.
SUPERTOKENS_CONNECTION_URI=https://supertokens.your-domain.com
# SUPERTOKENS_API_KEY=only_if_your_core_requires_one

# This app's own public origin, both values.
SUPERTOKENS_API_DOMAIN=https://dashboard.your-domain.com
SUPERTOKENS_WEBSITE_DOMAIN=https://dashboard.your-domain.com

# Client-safe copy of SUPERTOKENS_API_DOMAIN, read by the browser-side init.
# Same value as above — it needs the NEXT_PUBLIC_ prefix to reach the bundle.
NEXT_PUBLIC_SUPERTOKENS_API_DOMAIN=https://dashboard.your-domain.com


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# The shared `users` collection. Point this at the SAME database as the server:
# the dashboard seeds a profile row at sign-up, and the server is the only
# writer of tier, subscriptionStatus, and currentPeriodEnd. Two databases means
# paid customers silently reading as free.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/cheela?retryWrites=true&w=majority


# -----------------------------------------------------------------------------
# Cheela API
# -----------------------------------------------------------------------------
# The deployed server's public URL. Used server-side by the /api/proxy route,
# which attaches the session token — the browser never calls the API directly.
#
# It carries the NEXT_PUBLIC_ prefix for historical reasons and is inlined at
# build time, so this must be set BEFORE the build, not just at runtime.
NEXT_PUBLIC_API_URL=https://api.your-domain.com


# -----------------------------------------------------------------------------
# OAuth — optional
# -----------------------------------------------------------------------------
# The sign-in buttons render whether or not these are set, and fail at the
# provider redirect when they are not. Leave them commented to ship
# email/password only, or remove the buttons from components/auth/auth-form.tsx.
#
# Callback URL to register with each provider:
#     https://dashboard.your-domain.com/auth/callback/google
#     https://dashboard.your-domain.com/auth/callback/github

# Google Cloud Console -> Credentials -> OAuth 2.0 Client ID
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub -> Settings -> Developer settings -> OAuth Apps
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Deliberately absent
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_RAZORPAY_KEY_ID is NOT needed. The checkout key arrives in the
# /v1/billing/checkout response from the server (upgrade-button.tsx reads
# order.keyId), so configuring it here would be dead config that drifts out of
# sync with whatever the server is actually charging against.
