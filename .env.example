# SuperTokens — the dashboard hosts the real auth API (sign up/in, refresh, thirdparty callback)
# Local dev: http://localhost:3567 (see docker-compose.yml at the repo root)
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
# SUPERTOKENS_API_KEY=only_needed_if_the_core_itself_requires_one
SUPERTOKENS_API_DOMAIN=http://localhost:3001
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3001
# Client-safe copy of SUPERTOKENS_API_DOMAIN, read by the browser-side init
NEXT_PUBLIC_SUPERTOKENS_API_DOMAIN=http://localhost:3001

# MongoDB — minimal user-profile collection (userId, email, createdAt, tier)
MONGODB_URI=mongodb://cheela:cheela@localhost:27017

# Google OAuth (SuperTokens ThirdParty) — from Google Cloud Console
# Sign-in buttons render regardless, but error until these are set
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth (SuperTokens ThirdParty) — from GitHub Developer Settings
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Cheela Cloud API (deployed server URL) — used server-side by the /api/proxy route
NEXT_PUBLIC_API_URL=http://localhost:3000

# Razorpay (client key only — secret stays on the server)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxx
